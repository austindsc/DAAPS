@article{kolodinski_quantum_1993,
	title = {Quantum efficiencies exceeding unity due to impact ionization in silicon solar cells},
	volume = {63},
	issn = {0003-6951},
	url = {https://doi.org/10.1063/1.110489},
	doi = {10.1063/1.110489},
	abstract = {Absolute measurements demonstrate internal quantum efficiencies in silicon solar cells to exceed unity for photon energies above the first direct band gap and to show distinct spectral features that correspond to specific points in the Brillouin zone. Ultraviolet radiation can generate hot carriers with sufficient energy to cause impact ionization which results in two electron hole pairs per incident photon.},
	number = {17},
	urldate = {2024-01-12},
	journal = {Applied Physics Letters},
	author = {Kolodinski, Sabine and Werner, Jurgen H. and et al.},
	month = oct,
	year = {1993},
	pages = {2405--2407}
}

@article{zalewski_silicon_1983,
	title = {Silicon photodiode device with 100\% external quantum efficiency},
	volume = {22},
	copyright = {© 1983 Optical Society of America},
	issn = {2155-3165},
	url = {https://opg.optica.org/ao/abstract.cfm?uri=ao-22-18-2867},
	doi = {10.1364/AO.22.002867},
	abstract = {A device utilizing four inversion layer photodiodes in a light-trapping arrangement was constructed and tested. The device was found to have a photon-to-electron conversion efficiency of 0.999 for short wavelength and low power visible radiation. It was found that applying a reverse bias voltage extended the high quantum efficiency response over the entire visible spectrum and up to the highest radiant power level studied (several milliwatts). Several radiometrically important characteristics were studied and the results presented: spectral reflectance; polarization sensitivity; quantum efficiency vs wavelength, photon flux density, and reverse bias voltage; and dark current vs reverse bias.},
	language = {EN},
	number = {18},
	urldate = {2024-10-03},
	journal = {Applied Optics},
	author = {Zalewski, Edward F. and Duda, C. Richard},
	month = sep,
	year = {1983},
	note = {Publisher: Optica Publishing Group},
	pages = {2867--2873},
}


