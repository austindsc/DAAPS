	keywords = {atmospheric turbulence, avalanche photodiode (APD), Error analysis, Free space optical (FSO) communication, MIMO, multiple input multiple output (MIMO) processing, Optical modulation, Optical receivers, Optical transmitters, Performance analysis, Performance gain, Photodetectors, Pulse modulation, pulse position modulation (PPM), Upper bound},
	pages = {3--12},
	file = {IEEE Xplore Full Text PDF:C\:\\Users\\harry\\Zotero\\storage\\RMFUEZ76\\Cvijetic et al. - 2008 - Performance Bounds for Free-Space Optical MIMO Sys.pdf:application/pdf},
}

@inproceedings{tolker-nielsen_-orbit_2002,
