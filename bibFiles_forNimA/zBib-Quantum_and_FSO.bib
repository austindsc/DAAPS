	month = jun,
	year = {2021},
	note = {Number: 1
Publisher: Nature Publishing Group},
	keywords = {Integrated optics, Atmospheric optics, Fibre optics and optical communications, Photonic devices, Qubits},
	pages = {1--8},
	file = {Full Text PDF:C\:\\Users\\harry\\Zotero\\storage\\QJ4XVTDZ\\Avesani et al. - 2021 - Full daylight quantum-key-distribution at 1550 nm .pdf:application/pdf},
